{
  "name": "@u1f992/gs-wasm",
  "version": "0.2.1",
  "description": "WASM build variant of ArtifexSoftware/ghostpdl 10.07.0.",
  "main": "dist/index.js",
  "bin": {
    "gs-wasm": "dist/cli.js"
  },
  "scripts": {
    "lint": "eslint --fix \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "build:wasm": "sh ./build-wasm.sh && shx cp ghostpdl/bin/gs.js src/gs.js && shx cp ghostpdl/bin/gs.wasm src/gs.wasm",
    "clean:wasm": "cd ghostpdl && emmake make clean && cd .. && shx rm src/gs.js src/gs.wasm",
    "build": "tsc && shx cp src/gs.js dist/gs.js && shx cp src/gs.wasm dist/gs.wasm",
    "clean": "shx rm -rf dist",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "keywords": [],
  "author": "Koutaro Mukai",
  "license": "AGPL-3.0-only",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "upath": "^3.0.7",
    "web-worker": "^1.5.0"
  }
}
